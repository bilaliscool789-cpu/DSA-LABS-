template <typename T>
class AbstractStack
{
public:
    virtual void push(T value) = 0;
    virtual T pop() = 0;
    virtual T top() const = 0;
    virtual bool isEmpty() const = 0;
    virtual bool isFull() const = 0;
    virtual ~AbstractStack() {}
};

template <typename T>
class myStack : public AbstractStack<T>
{
private:
    T* arr;
    T* minArr;
    int maxSize;
    int currentSize;

public:
    myStack(int size)
    {
        maxSize = size;
        currentSize = 0;
        arr = new T[maxSize];
        minArr = new T[maxSize];
    }

    void push(T value)
    {
        if (isFull())
        {
            cout << "Stack is full. Cannot push element.\n";
            return;
        }

        arr[currentSize] = value;

        if (currentSize == 0 || value < minArr[currentSize - 1])
            minArr[currentSize] = value;
        else
            minArr[currentSize] = minArr[currentSize - 1];

        currentSize++;
        cout << "Element pushed successfully.\n";
    }

    T pop()
    {
        if (isEmpty())
        {
            cout << "Stack is empty. Cannot pop.\n";
            return T();
        }

        currentSize--;
        return arr[currentSize];
    }

    T top() const
    {
        if (isEmpty())
        {
            cout << "Stack is empty.\n";
            return T();
        }

        return arr[currentSize - 1];
    }

    bool isEmpty() const
    {
        return currentSize == 0;
    }

    bool isFull() const
    {
        return currentSize == maxSize;
    }

    T getMin() const
    {
        if (isEmpty())
        {
            cout << "Stack is empty. Minimum does not exist.\n";
            return T();
        }

        return minArr[currentSize - 1];
    }

    void display() const
    {
        if (isEmpty())
        {
            cout << "Stack is empty.\n";
            return;
        }

        cout << "Stack elements (top to bottom): ";
        for (int i = currentSize - 1; i >= 0; i--)
            cout << arr[i] << " ";
        cout << endl;
    }

    ~myStack()
    {
        delete[] arr;
        delete[] minArr;
    }
};


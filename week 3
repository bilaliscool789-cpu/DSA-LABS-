#pragma once
#include <iostream>
#include "MyList.h"
using namespace std;

template <class Type>
class CustomList : public MyList<Type>
{
public:
    CustomList(int size = 10) : MyList<Type>(size)
    {
    }

    CustomList(const CustomList& obj) : MyList<Type>(obj)
    {
    }

    Type sum_ofPrime()
    {
        Type sum = 0;

        for (int i = 0; i < this->currentSize; i++)
        {
            Type num = this->arr[i];
            bool prime = true;

            if (num < 2)
            {
                prime = false;
            }

            for (int j = 2; j < num; j++)
            {
                if (num % j == 0)
                {
                    prime = false;
                    break;
                }
            }

            if (prime)
            {
                sum = sum + num;
            }
        }

        return sum;
    }

    Type secondMaxEven()
    {
        Type max = 0;
        Type second = 0;
        bool foundMax = false;
        bool foundSecond = false;

        for (int i = 0; i < this->currentSize; i++)
        {
            Type num = this->arr[i];

            if (num % 2 == 0)
            {
                if (!foundMax || num > max)
                {
                    if (foundMax)
                    {
                        second = max;
                        foundSecond = true;
                    }

                    max = num;
                    foundMax = true;
                }
                else if (num < max && (!foundSecond || num > second))
                {
                    second = num;
                    foundSecond = true;
                }
            }
        }

        if (foundSecond)
            return second;

        return Type();
    }

    Type secondMinOdd()
    {
        Type min = 0;
        Type second = 0;
        bool foundMin = false;
        bool foundSecond = false;

        for (int i = 0; i < this->currentSize; i++)
        {
            Type num = this->arr[i];

            if (num % 2 != 0)
            {
                if (!foundMin || num < min)
                {
                    if (foundMin)
                    {
                        second = min;
                        foundSecond = true;
                    }

                    min = num;
                    foundMin = true;
                }
                else if (num > min && (!foundSecond || num < second))
                {
                    second = num;
                    foundSecond = true;
                }
            }
        }

        if (foundSecond)
            return second;

        return Type();
    }

    void printDuplicates()
    {
        bool found = false;

        for (int i = 0; i < this->currentSize; i++)
        {
            bool alreadyPrinted = false;

            for (int k = 0; k < i; k++)
            {
                if (this->arr[i] == this->arr[k])
                {
                    alreadyPrinted = true;
                    break;
                }
            }

            if (alreadyPrinted)
                continue;

            for (int j = i + 1; j < this->currentSize; j++)
            {
                if (this->arr[i] == this->arr[j])
                {
                    cout << this->arr[i] << " ";
                    found = true;
                    break;
                }
            }
        }

        if (!found)
            cout << "No duplicates found";

        cout << endl;
    }

    void rotateClockwaise(int r)
    {
        int mid = this->currentSize / 2;

        for (int part = 0; part < 2; part++)
        {
            int start, end;

            if (part == 0)
            {
                start = 0;
                end = mid;
            }
            else
            {
                start = mid;
                end = this->currentSize;
            }

            int n = end - start;

            if (n > 1)
            {
                r = r % n;

                for (int x = 0; x < r; x++)
                {
                    Type temp = this->arr[end - 1];

                    for (int i = end - 1; i > start; i--)
                    {
                        this->arr[i] = this->arr[i - 1];
                    }

                    this->arr[start] = temp;
                }
            }
        }
    }

    void rotateanitclockwaise(int rt)
    {
        int mid = this->currentSize / 2;

        for (int part = 0; part < 2; part++)
        {
            int start, end;

            if (part == 0)
            {
                start = 0;
                end = mid;
            }
            else
            {
                start = mid;
                end = this->currentSize;
            }

            int n = end - start;

            if (n > 1)
            {
                int rotations = rt % n;

                for (int x = 0; x < rotations; x++)
                {
                    Type temp = this->arr[start];

                    for (int i = start; i < end - 1; i++)
                    {
                        this->arr[i] = this->arr[i + 1];
                    }

                    this->arr[end - 1] = temp;
                }
            }
        }
    }

    ~CustomList()
    {
    }
};


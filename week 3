#include <iostream>
#include "CustomList.h"
using namespace std;

int main()
{
    CustomList<int> list(20);

    int choice, value, index, rotations;

    do
    {
        cout << "\n----- Generic List Menu -----" << endl;
        cout << "1. Add at first index" << endl;
        cout << "2. Add at last index" << endl;
        cout << "3. Remove from end" << endl;
        cout << "4. Remove from start" << endl;
        cout << "5. Check empty" << endl;
        cout << "6. Check full" << endl;
        cout << "7. Display size" << endl;
        cout << "8. Insert at index" << endl;
        cout << "9. Display last element" << endl;
        cout << "10. Search element" << endl;
        cout << "11. Display list" << endl;
        cout << "12. Sum of prime numbers" << endl;
        cout << "13. Second maximum even" << endl;
        cout << "14. Second minimum odd" << endl;
        cout << "15. Print duplicates" << endl;
        cout << "16. Rotate clockwise" << endl;
        cout << "17. Rotate anti-clockwise" << endl;
        cout << "0. Exit" << endl;

        cout << "Enter choice: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
            cout << "Enter value: ";
            cin >> value;
            list.addElementAtFirstIndex(value);
            break;

        case 2:
            cout << "Enter value: ";
            cin >> value;
            list.addElementAtLastIndex(value);
            break;

        case 3:
            cout << "Removed value: "
                 << list.removeElementFromEnd() << endl;
            break;

        case 4:
            list.removeElementFromStart();
            cout << "Element removed" << endl;
            break;

        case 5:
            if (list.empty())
                cout << "List is empty" << endl;
            else
                cout << "List is not empty" << endl;
            break;

        case 6:
            if (list.full())
                cout << "List is full" << endl;
            else
                cout << "List is not full" << endl;
            break;

        case 7:
            cout << "Current size: " << list.size() << endl;
            break;

        case 8:
            cout << "Enter index: ";
            cin >> index;

            cout << "Enter value: ";
            cin >> value;

            if (list.insertAt(index, value))
                cout << "Value inserted" << endl;
            else
                cout << "Invalid index or list is full" << endl;
            break;

        case 9:
            cout << "Last element: " << list.last() << endl;
            break;

        case 10:
            cout << "Enter value to search: ";
            cin >> value;

            if (list.search(value))
                cout << "Value found" << endl;
            else
                cout << "Value not found" << endl;
            break;

        case 11:
            list.display();
            break;

        case 12:
            cout << "Sum of prime numbers: "
                 << list.sum_ofPrime() << endl;
            break;

        case 13:
            cout << "Second maximum even: "
                 << list.secondMaxEven() << endl;
            break;

        case 14:
            cout << "Second minimum odd: "
                 << list.secondMinOdd() << endl;
            break;

        case 15:
            cout << "Duplicate elements: ";
            list.printDuplicates();
            break;

        case 16:
            cout << "Enter rotations: ";
            cin >> rotations;

            list.rotateClockwaise(rotations);
            cout << "List after rotation: ";
            list.display();
            break;

        case 17:
            cout << "Enter rotations: ";
            cin >> rotations;

            list.rotateanitclockwaise(rotations);
            cout << "List after rotation: ";
            list.display();
            break;

        case 0:
            cout << "Program ended" << endl;
            break;

        default:
            cout << "Invalid choice" << endl;
        }

    } while (choice != 0);

    return 0;
}


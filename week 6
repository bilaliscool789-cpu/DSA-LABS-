#include <iostream>
using namespace std;

class Node
{
public:
    string student;
    int priority;
    Node* next;

    Node(string name, int p)
    {
        student = name;
        priority = p;
        next = nullptr;
    }
};

class BookQueue
{
private:
    string bookName;
    Node* head;

public:
    BookQueue(string name)
    {
        bookName = name;
        head = nullptr;
    }

    void AddStudent(string name, int priority)
    {
        Node* newNode = new Node(name, priority);

        if (head == nullptr || priority > head->priority)
        {
            newNode->next = head;
            head = newNode;
            return;
        }

        Node* temp = head;

        while (temp->next != nullptr &&
            temp->next->priority >= priority)
        {
            temp = temp->next;
        }

        newNode->next = temp->next;
        temp->next = newNode;
    }

    void RemoveStudent(string name)
    {
        if (head == nullptr)
        {
            cout << "Reservation list is empty" << endl;
            return;
        }

        if (head->student == name)
        {
            Node* temp = head;
            head = head->next;
            delete temp;

            cout << "Reservation cancelled" << endl;
            return;
        }

        Node* temp = head;

        while (temp->next != nullptr &&
            temp->next->student != name)
        {
            temp = temp->next;
        }

        if (temp->next == nullptr)
        {
            cout << "Student not found" << endl;
        }
        else
        {
            Node* del = temp->next;
            temp->next = del->next;
            delete del;

            cout << "Reservation cancelled" << endl;
        }
    }

    void UpdatePriority(string name, int newPriority)
    {
        if (head == nullptr)
        {
            cout << "Reservation list is empty.\n";
            return;
        }

        Node* temp = head;

        while (temp != nullptr && temp->student != name)
        {
            temp = temp->next;
        }

        if (temp == nullptr)
        {
            cout << "Student not found.\n";
            return;
        }

        RemoveStudent(name);
        AddStudent(name, newPriority);

        cout << "Priority updated" << endl;
    }

    void Display()
    {
        Node* temp = head;

        cout << "\nBook: " << bookName << endl;

        if (head == nullptr)
        {
            cout << "No reservations" << endl;
            return;
        }

        while (temp != nullptr)
        {
            cout << "Student: " << temp->student
                << " | Priority: " << temp->priority << endl;

            temp = temp->next;
        }
    }

    void Count()
    {
        int count = 0;
        Node* temp = head;

        while (temp != nullptr)
        {
            count++;
            temp = temp->next;
        }

        cout << "Total reservations: " << count << endl;
    }

    void BookReturned()
    {
        if (head == nullptr)
        {
            cout << "No student waiting for this book" << endl;
            return;
        }

        Node* temp = head;

        cout << "Book issued to: " << temp->student << endl;

        head = head->next;
        delete temp;
    }

    ~BookQueue()
    {
        while (head != nullptr)
        {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
    }
};

int main()
{
    BookQueue book1("Data Structures");
    BookQueue book2("Programming Fundamentals");

    book1.AddStudent("Ali", 1);
    book1.AddStudent("Ahmed", 3);
    book1.AddStudent("Sara", 2);

    book2.AddStudent("Ayesha", 2);
    book2.AddStudent("Usman", 1);
    book2.AddStudent("Hassan", 3);

    cout << "\nInitial Reservations:";

    book1.Display();
    book2.Display();

    cout << "\nUpdating Ali's Priority:\n";
    book1.UpdatePriority("Ali", 3);

    book1.Display();

    cout << "\nCancelling Sara's Reservation:\n";
    book1.RemoveStudent("Sara");

    book1.Display();

    cout << "\nCounting Reservations:\n";
    book1.Count();
    book2.Count();

    cout << "\nBook Returned:\n";
    book1.BookReturned();

    book1.Display();

    cout << "\nSecond Book:\n";
    book2.Display();

    return 0;
}
